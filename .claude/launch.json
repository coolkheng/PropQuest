{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "start"],
      "port": 5001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "propquest", "run", "dev"],
      "port": 3000
    },
    {
      "name": "embedding-service",
      "runtimeExecutable": "embedding-service/.venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "app:app", "--app-dir", "embedding-service", "--port", "8000"],
      "port": 8000
    }
  ]
}
